# Recruiter login (MVP) — e-mail bepaalt rechten
# admin@blablabuild.com → sync + samenwerking (ADMIN_PASSWORD)
# recruiter@brandnewstart.nl → radar only (RECRUITER_PASSWORD)
RECRUITER_PASSWORD=bns-demo
ADMIN_PASSWORD=bns-admin
AUTH_SECRET=replace-with-long-random-string

# Apify — LinkedIn specialty + LinkedIn Jobs + Indeed
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-posts
APIFY_JOBS_ACTOR=curious_coder/linkedin-jobs-scraper
APIFY_INDEED_ACTOR=misceres/indeed-scraper

# Firecrawl — careers / platforms (src/lib/platforms.ts)
FIRECRAWL_API_KEY=

# Lusha — mail/tel ná een LinkedIn-profiel (nooit bulk)
LUSHA_API_KEY=

# OpenAI — eindklant raden + vacature-extract (gpt-4o-mini default)
OPENAI_API_KEY=
# optioneel: gpt-4o-mini (default) of gpt-4o
OPENAI_MODEL=

# Optioneel: Slack/Discord webhook voor alerts (bevestigingen, hot extracts)
ALERT_WEBHOOK_URL=

# TenderNed API (later)
TENDERNED_USER=
TENDERNED_PASS=

CRON_SECRET=

# Neon / Postgres
DATABASE_URL=
